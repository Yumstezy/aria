# Copy to .env and fill in. .env is gitignored. Never commit a real key.

# Meta Model API key for Muse Spark
MODEL_API_KEY=

# OpenAI compatible endpoint for Meta's Model API
MUSE_BASE_URL=https://api.meta.ai/v1

# muse-spark-1.1 is in Meta's examples. muse-spark-1.3 is newer. Day 1 tests pick one.
MUSE_MODEL=muse-spark-1.1
